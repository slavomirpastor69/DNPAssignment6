@page "/posts/create"
@attribute [Authorize]
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Create post</PageTitle>

<h1>Create post</h1>

<form @onsubmit="CreatePostAsync" style="max-width: 45rem">
    <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input class="form-control" id="title" @bind="title" autocomplete="off"/>
    </div>

    <div class="mb-3">
        <label class="form-label" for="body">Body</label>
        <textarea class="form-control" id="body" rows="6" @bind="body"></textarea>
    </div>

    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Create post</button>
</form>

@if (errorMessage != null)
{
    <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
}

@code {
    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = null!;

    private string title = "";
    private string body = "";
    private string? errorMessage;
    private bool isSubmitting;

    private async Task CreatePostAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Enter both a title and a body.";
            return;
        }

        isSubmitting = true;
        try
        {
            AuthenticationState authState = await State;
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = authState.User.GetUserId()
            });
            Navigation.NavigateTo($"posts/{created.Id}");
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
